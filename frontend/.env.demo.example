# Variables del despliegue de CUENTAS DE PRUEBA (proyecto Vercel aparte, proyecto Supabase aparte).
# Se cargan en Vercel > Settings > Environment Variables. No subir valores reales al repositorio.

# Proyecto Supabase del demo (Settings > API). La anon key es pública por diseño.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Activa la entrada por enlace (/nombre-del-colegio), la barra "Probando como" y el panel de pruebas
VITE_MODO_DEMO=true

# Archivos (tareas, consignas, comprobantes) en Supabase Storage, no en Cloudinary
VITE_ALMACENAMIENTO=supabase

# WhatsApp de contacto: solo números, con código de país (591...)
VITE_DEMO_WHATSAPP=591

# Dirección pública del demo, sin barra final (para la tarjeta de WhatsApp y los enlaces que copia el superadmin)
VITE_SITE_URL=https://tu-demo.vercel.app

# Opcional: texto de la tarjeta al compartir el enlace
# VITE_OG_TITULO=Gestión Educativa — Demo
# VITE_OG_DESCRIPCION=Prueba gratis el sistema de tu colegio: notas, asistencia, tareas, comunicados y pagos en un solo lugar.
